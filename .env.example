# Absolute URL of the deployed site — used for canonical links, Open Graph
# tags, robots.txt, and the sitemap.
#
# Only needed for a custom domain. On Vercel this is resolved automatically from
# VERCEL_PROJECT_PRODUCTION_URL, and locally it falls back to localhost, so a
# deployed build never ships localhost in its metadata either way.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
